# Copy this file to .env and fill in the real values.
#
#   Windows:  copy .env.example .env
#
# .env is git-ignored and must never be committed. This file is
# committed, so every value below must stay a placeholder — it exists
# to document which variables the application reads, not to carry any
# of them.
#
# Every name here maps to a field on Settings in app/core/config.py.
# The names must match exactly; Pydantic Settings falls back to an
# empty-string default when it cannot find one, which means a missing
# variable does not fail at startup — it fails much later, in the
# middle of whatever needed it.


# --- Application ------------------------------------------------------

APP_NAME=AI Job Hunting Agent

# development or production
APP_ENV=development

DEBUG=true

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# --- Telegram ---------------------------------------------------------

# From @BotFather. Treat this like a password: anyone holding it can
# post as your bot. If it ever leaks, /revoke in BotFather and issue a
# new one rather than hoping nobody noticed.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# polling or webhook. Polling needs no public URL, which is why it is
# the default for local development.
TELEGRAM_MODE=polling


# --- Database ---------------------------------------------------------

# Async driver, hence +psycopg rather than a bare postgresql:// URL.
# The password is embedded in this string, so resetting a leaked
# database password means editing this line, not just rotating a
# key somewhere else.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname


# --- CV storage -------------------------------------------------------

# Where uploaded CV files are written, relative to the project root.
CV_STORAGE_DIR=storage/cvs

# Uploads larger than this are rejected before anything touches disk.
MAX_CV_SIZE_MB=5


# --- Gemini -----------------------------------------------------------

# From https://aistudio.google.com/apikey — free tier is enough for
# development. Quotas are per Google Cloud project, not per key, so
# issuing extra keys in the same project will not raise your limit.
GEMINI_API_KEY=your-gemini-api-key-here

# Model identifier. Worth checking against current documentation
# rather than assuming, since these are renamed and retired on a
# timescale shorter than most projects.
GEMINI_MODEL=gemini-3.7-flash
